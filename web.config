<?xml version="1.0" encoding="utf-8"?>
<!--
  Popcorn - Family Movie Ratings
  Target host: DiscountASP.NET (Windows / IIS / ASP.NET 4.x)

  IMPORTANT - pick the connection string that matches your database file:

    * FamilyMovies.mdb  (Access 97-2003) -> Microsoft.Jet.OLEDB.4.0
      Requires the application pool to run in 32-bit mode
      (DiscountASP.NET Control Panel -> Web Options -> "Enable 32-bit").

    * FamilyMovies.accdb (Access 2007+)  -> Microsoft.ACE.OLEDB.12.0
      Requires the ACE redistributable on the server; ask DiscountASP.NET
      support to confirm which providers are installed on your server.

  |DataDirectory| resolves to ~/App_Data at runtime.
-->
<configuration>

  <appSettings>
    <!-- Free API key from https://www.omdbapi.com/apikey.aspx (the free tier is
         1,000 lookups/day, which is plenty for a family). Leave blank to run the
         site without automatic poster/synopsis lookups. -->
    <add key="OmdbApiKey" value="" />

    <!-- One-time password required by Setup.aspx. CHANGE THIS before uploading,
         and blank it out again once the site is installed. -->
    <add key="SetupKey" value="change-me-before-you-deploy" />

    <!-- Site name shown in the header / browser title. -->
    <add key="SiteName" value="Popcorn" />
  </appSettings>

  <connectionStrings>
    <!-- Access 97-2003 (.mdb) + Jet, the safest bet on shared hosting -->
    <add name="FamilyMovies"
         connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=|DataDirectory|FamilyMovies.mdb;Persist Security Info=False;"
         providerName="System.Data.OleDb" />

    <!-- Access 2007+ (.accdb) + ACE. Comment out the entry above and uncomment
         this one if your server has the ACE provider installed.
    <add name="FamilyMovies"
         connectionString="Provider=Microsoft.ACE.OLEDB.12.0;Data Source=|DataDirectory|FamilyMovies.accdb;Persist Security Info=False;"
         providerName="System.Data.OleDb" />
    -->
  </connectionStrings>

  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <httpRuntime maxRequestLength="4096" enableVersionHeader="false" />

    <authentication mode="Forms">
      <forms name=".POPCORN"
             loginUrl="~/Login.aspx"
             defaultUrl="~/Default.aspx"
             protection="All"
             timeout="20160"
             slidingExpiration="true"
             cookieless="UseCookies" />
    </authentication>

    <!-- Everything requires an approved, signed-in account unless allowed below. -->
    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" timeout="120" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <pages enableViewState="false" enableSessionState="true" />
  </system.web>

  <!-- Anonymous pages -->
  <location path="Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Register.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Pending.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Setup.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Error.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Content">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
