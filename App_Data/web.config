<?xml version="1.0" encoding="utf-8"?>
<!-- Belt and braces. ASP.NET already refuses to serve anything out of a folder
     called App_Data; this makes sure of it even if the site is ever hosted
     somewhere less strict.

     Deliberately only <authorization>: the handler sections are locked down on
     a lot of shared hosting, and a sub-folder web.config that touches them is
     a reliable way to earn an HTTP 500.19. -->
<configuration>
  <system.web>
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
</configuration>
